<!--
  android:screenOrientation="portrait" 는 제거했다.
  targetSdk 36(Android 16)부터 대형 화면에서 방향·크기 제한이 무시되고,
  Play Console 이 "지원 중단된 API/파라미터"와 "크기 조절 및 방향 제한 삭제"로
  경고한다. 제한을 지우고 레이아웃이 가로·태블릿에서도 버티게 하는 쪽이 맞다.
  (configChanges 에 orientation|screenSize|screenLayout 이 이미 있어서
   회전해도 액티비티가 재시작되지 않는다 — 상태가 날아가지 않는다.)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-8353634332299342~7516567553" tools:replace="android:value"/>
    <meta-data android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT" android:value="true" tools:replace="android:value"/>
    <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING" android:value="true" tools:replace="android:value"/>
    <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION" android:value="true" tools:replace="android:value"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:resizeableActivity="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- 공유 코드 딥링크 (v1.3) — QR 에 담긴 jeonryeokkami://add?c=JY1-… 를 폰 카메라가
           열면 앱이 뜨고 '공유 코드로 추가' 시트가 열린다. app.json 의 scheme 과 같은 값.
           bare 워크플로라 prebuild 가 넣어주지 않는다 — 여기서 직접 관리한다. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="jeonryeokkami" android:host="add"/>
      </intent-filter>
    </activity>
    <!-- 홈 화면 위젯 (react-native-android-widget).
         bare 워크플로라 config plugin 이 돌지 않는다 — 플러그인이 넣던 receiver·service 를
         여기서 직접 관리한다. 예전엔 이 항목이 없어서 위젯 코드가 있어도 런처 위젯 목록에
         나타나지 않았다. receiver 이름(.widget.X)의 X 가 JS 의 widgetName 이다. -->
    <receiver android:name=".widget.Discharge" android:exported="false" android:label="전역까지 · 기본">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
        <action android:name="com.jeonryeokkami.app.WIDGET_CLICK"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widgetprovider_discharge"/>
    </receiver>
    <receiver android:name=".widget.DdaySimple" android:exported="false" android:label="전역까지 · 심플">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
        <action android:name="com.jeonryeokkami.app.WIDGET_CLICK"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widgetprovider_ddaysimple"/>
    </receiver>
    <service android:name="com.reactnativeandroidwidget.RNWidgetCollectionService" android:permission="android.permission.BIND_REMOTEVIEWS"/>
  </application>
</manifest>