<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 '심플' (2×1) — 큰 D-Day + 진행 막대. app.json 의 widgets 항목과 값을 맞춰 둘 것. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="50dp"
    android:minResizeWidth="80dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="160dp"
    android:resizeMode="horizontal|vertical"
    android:description="@string/widget_ddaysimple_description"
    android:initialLayout="@layout/rn_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_preview_ddaysimple"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen">
</appwidget-provider>
